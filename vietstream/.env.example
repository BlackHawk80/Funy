# Cấu hình mẫu — copy thành .env (hoặc set biến môi trường khi deploy)

PORT=7001
# Chỉ bật một số nguồn (bỏ comment nếu cần)
# Xem20 chỉ bật khi có đủ XEM20_LOGIN + XEM20_PASSWORD.
# PROVIDERS=kkphim,k20,xem20,nguonc,phim4k,tophim,vnstream,ophim

# Nguồn nào đi qua HLS proxy chống 403: danh sách / * / none
# PROXY_PROVIDERS=nguonc

# Đổi domain khi nguồn chuyển host
# KKPHIM_API_URL=https://phimapi.com
# NGUONC_API_URL=https://phim.nguonc.com/api
# PHIM4K_API_URL=https://vsmov.com/api
# TOPHIM_API_URL=https://tophim.top
# K20_API_URL=https://sc.k-20.xyz
# XEM20_SITE_URL=https://xem20.net
# OPHIM_API_URL=https://www.ophim.live
# VNSTREAM_API_URL=https://egluy2hhb21vaw5ndw9pbmhl.darkbytes.xyz/api/v1
# VNSTREAM_SITE_URL=https://cobephim.biz

# Thông tin đăng nhập Xem20 — chỉ set dưới dạng secret trên Render, không commit giá trị thật.
# XEM20_LOGIN=
# XEM20_PASSWORD=
# XEM20_AUTH_TIMEOUT=12000
# XEM20_SEARCH_TIMEOUT=8000
# XEM20_DETAIL_TIMEOUT=10000
# XEM20_STREAM_TIMEOUT=12000

# TIMEOUT=8000
# TIMEOUT_STREAM=9000
# DEBUG=1
